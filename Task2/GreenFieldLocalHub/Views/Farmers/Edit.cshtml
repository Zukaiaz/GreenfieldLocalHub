@model GreenFieldLocalHub.Models.Farmers

@{
    ViewData["Title"] = "Edit Farmer Profile";
}

@* Link to the custom styling for the edit page *@
<link rel="stylesheet" href="~/css/farmersE.css" />

<div class="edit-container">
    <div class="edit-header">
        <h1>Update Profile</h1>
        <p>Modify your farm information or update your profile image.</p>
    </div>

    <div class="edit-card">
        @* enctype="multipart/form-data" is required for image/file uploads to work *@
        <form asp-action="Edit" enctype="multipart/form-data">

            @* These hidden inputs ensure the IDs are preserved during the save process *@
            <input type="hidden" asp-for="FarmersId" />
            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="ModelOnly" class="error-summary"></div>

            @* Farmer Name Edit Field *@
            <div class="input-group">
                <label asp-for="FarmerName" class="field-label"></label>
                <input asp-for="FarmerName" class="field-input" />
                <span asp-validation-for="FarmerName" class="error-message"></span>
            </div>

            @* Email Edit Field *@
            <div class="input-group">
                <label asp-for="FarmerEmail" class="control-label"></label>
                @* type="email" triggers mobile keyboards to show the '@' key and validates format *@
                <input asp-for="FarmerEmail"
                       class="form-control"
                       type="email"
                       placeholder="farmer@example.com" />
                <span asp-validation-for="FarmerEmail" class="text-danger"></span>
            </div>

            @* Farming Method Edit Field *@
            <div class="input-group">
                <label asp-for="FarmingMethod" class="field-label"></label>
                <input asp-for="FarmingMethod" class="field-input" />
                <span asp-validation-for="FarmingMethod" class="error-message"></span>
            </div>

            @* Farmer Bio Edit Field *@
            <div class="input-group">
                <label asp-for="FarmerInfo" class="field-label"></label>
                <textarea asp-for="FarmerInfo" class="field-input textarea"></textarea>
                <span asp-validation-for="FarmerInfo" class="error-message"></span>
            </div>

            @* IMAGE UPLOAD SECTION *@
            <div class="input-group">
                <label class="field-label">Update Profile Image</label>
                <div class="file-upload-wrapper">
                    <input type="file"
                           name="ImageFile"
                           class="file-input-hidden"
                           accept="image/*"
                           id="imageUpload" />
                    <label for="imageUpload" class="file-label-custom">Choose New Photo</label>
                </div>

                @* Server-side error message if image upload fails *@
                <span class="error-message">
                    @ViewData["ImageError"]
                </span>
            </div>

            @* JAVASCRIPT IMAGE PREVIEW CONTAINER *@
            <div class="preview-section" id="previewContainer" style="display:none;">
                <label class="field-label">New Image Preview:</label>
                <div class="preview-box">
                    <img id="imagePreview" src="#" alt="Image Preview" class="img-fluid rounded" />
                </div>
            </div>

            @* FORM SAVE ACTION *@
            <div class="button-group">
                <button type="submit" class="btn-save">Save Changes</button>
                <a asp-action="Index" class="btn-cancel">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        @* Enables real-time browser validation based on model data annotations *@
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        @* Client-side script to show the selected image immediately before uploading *@
        document.getElementById('imageUpload').addEventListener('change', function (e) {
            const file = e.target.files[0];
            const preview = document.getElementById('imagePreview');
            const container = document.getElementById('previewContainer');

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    container.style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                preview.src = '#';
                container.style.display = 'none';
            }
        });
    </script>
}