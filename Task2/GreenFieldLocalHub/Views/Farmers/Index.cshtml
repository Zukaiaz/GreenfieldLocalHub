@model IEnumerable<GreenFieldLocalHub.Models.Farmers>

<link rel="stylesheet" href="~/css/FarmersP.css" />

@{
    ViewData["Title"] = "Farmers";
}

<h1 class="section-title">Our Farmers</h1>

<div class="farmers-grid">
    @foreach (var item in Model)
    {
        <a asp-action="Details" asp-route-id="@item.FarmersId" class="farmer-card">

            <img src="@item.ImagePath" class="farmer-img" />

            <div class="farmer-card-body">
                <div class="farmer-name">@item.FarmerName</div>
                <div class="farmer-method">@item.FarmingMethod</div>

                <div class="farmer-info">
                    @item.FarmerInfo
                </div>

                <div class="farmer-email">@item.FarmerEmail</div>
            </div>

        </a>
    }
</div>