@model IEnumerable<GreenFieldLocalHub.Models.Farmers>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FarmerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FarmerEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FarmingMethod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FarmerInfo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FarmerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FarmerEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FarmingMethod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FarmerInfo)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.FarmersId">Details</a> |
            </td>
        </tr>
}
    </tbody>
</table>
