@model IEnumerable<GreenFieldLocalHub.Models.LoyaltyTransactions>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PointsChange)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoyaltyAccount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Orders)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PointsChange)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Reason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoyaltyAccount.LoyaltyAccountId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Orders.OrdersId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.LoyaltyTransactionsId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.LoyaltyTransactionsId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.LoyaltyTransactionsId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
