@model IEnumerable<GreenFieldLocalHub.Models.BasketProducts>
@{
    ViewData["Title"] = "Your Basket";
}

<h1>Your Basket</h1>

@if (!Model.Any())
{
    <p>Your basket is empty.</p>
    <p>You havent added any products yet.</p>
    <a asp-controller="Products" asp-action="Index">Continue Shopping</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Products.ProductName</td>
                    <td>£@item.Products.ProductPrice</td>
                    <td>@item.ProductQuantity</td>
                    <td>£@(item.Products.ProductPrice * item.ProductQuantity)</td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@item.BasketProductsId">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <div>
        <p>Subtotal: £@ViewBag.Subtotal</p>
        <p>Loyalty Tier: @ViewBag.Tier</p>
        <p>Discount: -£@ViewBag.DiscountAmount</p>
        <h4><strong>Total: £@ViewBag.Total</strong></h4>
    </div>




    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>
    <a asp-controller="Orders" asp-action="Create" class="btn btn-success">Checkout</a>
}