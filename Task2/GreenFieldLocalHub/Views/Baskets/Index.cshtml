@model IEnumerable<GreenFieldLocalHub.Models.BasketProducts>
@{
    ViewData["Title"] = "Your Basket";
}

<h1>Your Basket</h1>

@if (!Model.Any())
{
    <div>
        <h3>Your basket is empty</h3>
        <p>Looks like you haven't added any products yet.</p>

    </div>
}
else
{
    <div>
        <div>
            @foreach (var item in Model)
            {
                <div style="border:1px solid #ccc; padding:10px; margin-bottom:10px;">

                    <div>
                        <h4>@item.Products.ProductName</h4>
                        <p>Price: £@item.Products.ProductPrice.ToString("0.00")</p>
                    </div>

                    <div>
                        <p>Qty: @item.ProductQuantity</p>
                    </div>

                    <div>
                        <p>
                            Total: £@((item.Products.ProductPrice * item.ProductQuantity).ToString("0.00"))
                        </p>
                    </div>

                    <a asp-controller="BasketProducts"
                       asp-action="Delete"
                       asp-route-id="@item.BasketProductsId">
                        Remove
                    </a>

                </div>
            }
        </div>
    </div>

    <div style="border:1px solid #000; padding:15px; margin-top:20px;">
        <h3>Order Summary</h3>

        <div>
            <span>Subtotal:</span>
            <span>£@(((decimal)ViewBag.Subtotal).ToString("0.00"))</span>
        </div>

        <div>
            <span>Loyalty Discount (@ViewBag.Tier):</span>
            <span>-£@(((decimal)ViewBag.DiscountAmount).ToString("0.00"))</span>
        </div>

        <hr />

        <div>
            <strong>Total:</strong>
            <strong>£@(((decimal)ViewBag.Total).ToString("0.00"))</strong>
        </div>



        <a asp-controller="Products" asp-action="Index">
            Continue Shopping
        </a>
        <a asp-controller="Orders"
           asp-action="Create"
           asp-route-basketId="@ViewBag.BasketId"
           class="btn btn-primary w-100 mb-2">
            Proceed to Checkout
        </a>

    </div>
}