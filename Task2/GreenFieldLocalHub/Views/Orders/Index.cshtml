@model IEnumerable<GreenFieldLocalHub.Models.Orders>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<table class="table">
    <thead>
        <tr>
            @if (User.IsInRole("Farmer") || User.IsInRole("Admin"))
            {
                <th>Customer</th>
            }
            <th>
                @Html.DisplayNameFor(model => model.TotalAmount)
            </th>
            <th>Items</th>
            <th>
                @Html.DisplayNameFor(model => model.Delivery)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Collection)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeliveryType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderTrackingStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CollectionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                @if (User.IsInRole("Farmer") || User.IsInRole("Admin"))
                {
                    <td>
                        @{
                            var emailDict = (Dictionary<string, string>)ViewBag.UserEmails;
                            var userEmail = emailDict != null && emailDict.ContainsKey(item.UserId) ? emailDict[item.UserId] : "Unknown";
                        }
                        @userEmail
                    </td>
                }
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
                <td>
                    @foreach (var op in item.OrderProducts)
                    {
                        <div>@op.Products.ProductName x @op.ProductsQuantity</div>
                    }
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Delivery)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Collection)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeliveryType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderTrackingStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.OrdersId">Details</a> |
            </td>
        </tr>
}
    </tbody>
</table>
