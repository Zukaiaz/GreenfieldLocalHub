@{
    ViewData["Title"] = "Checkout";
}

<h2>Checkout</h2>
<hr />

@if (ViewBag.BasketProducts != null)
{
    <h4>Order Summary</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.BasketProducts)
            {
                <tr>
                    <td>@item.Products.ProductName</td>
                    <td>£@item.Products.ProductPrice</td>
                    <td>@item.ProductQuantity</td>
                    <td>£@(item.Products.ProductPrice * item.ProductQuantity)</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />
    <p>Subtotal: £@ViewBag.Subtotal</p>
    <p>Loyalty Tier: @ViewBag.Tier</p>
    <p>Discount: -£@ViewBag.DiscountAmount</p>
    <h4><strong>Total: £@ViewBag.Total</strong></h4>
    <hr />
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Delivery Type</label>
        <select name="DeliveryType" class="form-select" id="deliveryTypeSelect">
            <option value="">-- Select --</option>
            <option value="Delivery">Delivery</option>
            <option value="Collection">Collection</option>
        </select>
    </div>

    <div id="collectionDateDiv" class="mb-3" style="display:none">
        <label class="form-label">Collection Date</label>
        <input type="date" name="CollectionDate" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Place Order</button>
    <a asp-controller="Baskets" asp-action="Index" class="btn btn-secondary">Back to Basket</a>
</form>

@section Scripts {
    <script>
        document.getElementById('deliveryTypeSelect').addEventListener('change', function () {
            var collectionDiv = document.getElementById('collectionDateDiv');
            collectionDiv.style.display = this.value === 'Collection' ? 'block' : 'none';
        });
    </script>
}