@model IEnumerable<GreenFieldLocalHub.Models.OrderProducts>
@{
    ViewData["Title"] = "Order Details";
    var firstItem = Model?.FirstOrDefault();
}

<link rel="stylesheet" href="~/css/ordersD.css" />

<div class="details-container">
    <div class="details-card">
        @if (firstItem != null && firstItem.Orders != null)
        {
            <div class="details-header">
                <div>
                    <h1>Order #@firstItem.Orders.OrdersId</h1>
                    @* Simplified date string to avoid FormatException *@
                    <p class="order-date">Placed on @firstItem.Orders.OrderDate.ToShortDateString()</p>
                </div>
                <div class="status-section">
                    <span class="label">Current Status:</span>
                    @if (User.IsInRole("Farmer"))
                    {
                        <form asp-controller="Orders" asp-action="UpdateStatus" method="post" class="status-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@firstItem.Orders.OrdersId" />
                            <select name="status" class="status-select" onchange="this.form.submit()">
                                <option value="Pending" selected="@(firstItem.Orders.OrderTrackingStatus == "Pending" ? "selected" : null)">Pending</option>
                                <option value="Confirmed" selected="@(firstItem.Orders.OrderTrackingStatus == "Confirmed" ? "selected" : null)">Confirmed</option>
                                <option value="Preparing" selected="@(firstItem.Orders.OrderTrackingStatus == "Preparing" ? "selected" : null)">Preparing</option>
                                <option value="Out for Delivery" selected="@(firstItem.Orders.OrderTrackingStatus == "Out for Delivery" ? "selected" : null)">Out for Delivery</option>
                                <option value="Delivered" selected="@(firstItem.Orders.OrderTrackingStatus == "Delivered" ? "selected" : null)">Delivered</option>
                                <option value="Ready for Collection" selected="@(firstItem.Orders.OrderTrackingStatus == "Ready for Collection" ? "selected" : null)">Ready for Collection</option>
                                <option value="Collected" selected="@(firstItem.Orders.OrderTrackingStatus == "Collected" ? "selected" : null)">Collected</option>
                            </select>
                        </form>
                    }
                    else
                    {
                        <span class="status-badge">@firstItem.Orders.OrderTrackingStatus</span>
                    }
                </div>
            </div>

            <div class="info-grid">
                <div class="info-block">
                    <h3>Billing Summary</h3>
                    <p class="total-row"><strong>Total Amount:</strong> <span class="price-big">£@firstItem.Orders.TotalAmount.ToString("F2")</span></p>
                    @if ((decimal)ViewBag.DiscountAmount > 0)
                    {
                        <p class="discount-text">
                            <span class="badge-discount">@ViewBag.Tier Tier</span>
                            Saved £@(((decimal)ViewBag.DiscountAmount).ToString("F2"))
                        </p>
                    }
                </div>

                <div class="info-block">
                    <h3>Fulfillment</h3>
                    @if (firstItem.Orders.Delivery)
                    {
                        <p><strong>Method:</strong> 🚚 Delivery</p>
                        <p><strong>Type:</strong> @firstItem.Orders.DeliveryType</p>
                    }
                    else if (firstItem.Orders.Collection)
                    {
                        <p><strong>Method:</strong> 🧺 Collection</p>
                        <p><strong>Date:</strong> @firstItem.Orders.CollectionDate?.ToString("D")</p>
                    }
                </div>
            </div>

            <div class="products-section">
                <h2>Items in this Order</h2>
                <div class="table-wrapper">
                    <table class="details-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Unit Price</th>
                                <th>Qty</th>
                                <th class="text-right">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="product-name">@item.Products.ProductName</td>
                                    <td>£@item.Products.ProductPrice.ToString("F2")</td>
                                    <td>@item.ProductsQuantity</td>
                                    <td class="text-right font-bold">£@((item.Products.ProductPrice * item.ProductsQuantity).ToString("F2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="details-footer">
            <a asp-action="Index" class="btn-back">← Back to Orders</a>
        </div>
    </div>
</div>