@model IEnumerable<GreenFieldLocalHub.Models.OrderProducts>
@{
    ViewData["Title"] = "Order Details";
    var firstItem = Model.FirstOrDefault();
}
<h1>Order Details</h1>
@if (firstItem != null)
{
    <div>
        <p><strong>Order ID:</strong> @firstItem.Orders.OrdersId</p>
        <p><strong>Order Date:</strong> @firstItem.Orders.OrderDate</p>
        <p><strong>Status:</strong> @firstItem.Orders.OrderTrackingStatus</p>
        <p><strong>Total Amount:</strong> £@firstItem.Orders.TotalAmount.ToString("0.00")</p>
        @if (firstItem.Orders.Delivery)
        {
            <p><strong>Order Method:</strong> Delivery</p>
            <p><strong>Delivery Type:</strong> @firstItem.Orders.DeliveryType</p>
        }
        @if (firstItem.Orders.Collection)
        {
            <p><strong>Order Method:</strong> Collection</p>
            <p><strong>Collection Date:</strong> @firstItem.Orders.CollectionDate</p>
        }
    </div>
    <hr />
    <h2>Products Ordered</h2>
    <table>
        <thead>
            <tr>
                <th style="text-align:left; padding-right:20px;">Product</th>
                <th style="text-align:left; padding-right:20px;">Price</th>
                <th style="text-align:left; padding-right:20px;">Quantity</th>
                <th style="text-align:left; padding-right:20px;">Line Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="padding-right:20px;">@item.Products.ProductName</td>
                    <td style="padding-right:20px;">£@item.Products.ProductPrice.ToString("0.00")</td>
                    <td style="padding-right:20px;">@item.ProductsQuantity</td>
                    <td style="padding-right:20px;">£@((item.Products.ProductPrice * item.ProductsQuantity).ToString("0.00"))</td>
                </tr>
            }
        </tbody>
    </table>
}
<div style="margin-top:20px;">
    @if (User.IsInRole("Farmer"))
    {
        <a asp-action="Edit" asp-route-id="@firstItem?.Orders.OrdersId">Edit Order</a>
    }
    <a asp-action="Index">Back to List</a>
</div>