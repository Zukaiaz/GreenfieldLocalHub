@model IEnumerable<GreenFieldLocalHub.Models.Products>

@{
    ViewData["Title"] = "Shop";

}

<link rel="stylesheet" href="~/css/ProductsP.css" />

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<input type="hidden"
       id="requestToken"
       value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

<button onclick="toggleBasket()"
        id="basketToggleBtn"
        class="basket-toggle">
    ‹
</button>

<div class="shop-layout">

    <!-- LEFT SIDE -->

    <div class="shop-main">

        <!-- FILTER BAR -->

            <div class="right-filters">

                <a asp-action="Index"
                   asp-route-sort="priceAsc"
                   class="sort-btn">
                    Price ascending
                </a>

                <a asp-action="Index"
                   asp-route-sort="priceDesc"
                   class="sort-btn">
                    Price descending
                </a>

            </div>

        </div>

        <!-- PRODUCT GRID -->

        <div class="product-grid">

            @foreach (var item in Model)
            {
                <div class="product-card">

                    <img src="@item.ImagePath"
                         class="product-image"
                         alt="@item.ProductName" />

                    <div class="product-info">

                        <h6>
                            @item.ProductName
                        </h6>

                        <p class="price">
                            £@item.ProductPrice
                        </p>

                        @if (item.StockQuantity > 0)
                        {
                            <button class="btn btn-success add-to-basket-btn"
                                    data-product-id="@item.ProductsId">
                                Add to Basket
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-secondary" disabled>
                                Out of Stock
                            </button>
                        }

                    </div>

                </div>
            }

        </div>

        <!-- PAGINATION -->

        <div class="pagination-bar">
            <button class="page-btn">1</button>
            <button class="page-btn">2</button>
            <button class="page-btn">3</button>
        </div>

    </div>

</div>

<!-- BASKET SIDEBAR -->

<div id="basketSidebar">

    <h4>Your Basket</h4>

    <div id="basketContent">
        Loading...
    </div>

</div>

<script>

    let basketOpen = false;

    async function toggleBasket() {

        const sidebar =
            document.getElementById('basketSidebar');

        const btn =
            document.getElementById('basketToggleBtn');

        basketOpen = !basketOpen;

        if (basketOpen) {

            sidebar.style.right = '0';

            btn.style.right = '350px';

            btn.innerHTML = '›';

            await loadBasket();

        }
        else {

            sidebar.style.right = '-350px';

            btn.style.right = '0';

            btn.innerHTML = '‹';

        }

    }

    async function loadBasket() {

        const response =
            await fetch('/Products/SidebarPartial');

        const html =
            await response.text();

        document.getElementById('basketContent')
            .innerHTML = html;

    }

    document.addEventListener('click',
    async function (e) {

        const btn =
            e.target.closest('.add-to-basket-btn');

        if (!btn) return;

        const productId =
            btn.dataset.productId;

        const token =
            document.getElementById('requestToken').value;

        btn.disabled = true;

        btn.textContent = 'Adding...';

        const response =
            await fetch('/BasketProducts/Create', {

                method: 'POST',

                headers: {

                    'Content-Type':
                    'application/x-www-form-urlencoded',

                    'X-Requested-With':
                    'XMLHttpRequest'

                },

                body:
                `ProductsId=${productId}&__RequestVerificationToken=${encodeURIComponent(token)}`

            });

        if (response.ok) {

            btn.textContent = 'Added ✓';

            btn.classList.replace(
                'btn-success',
                'btn-primary'
            );

            if (!basketOpen) {

                basketOpen = true;

                document
                    .getElementById('basketSidebar')
                    .style.right = '0';

            }

            await loadBasket();

            setTimeout(() => {

                btn.disabled = false;

                btn.textContent =
                    'Add to Basket';

            }, 1500);

        }

    });

</script>