@model IEnumerable<GreenFieldLocalHub.Models.Products>

@{
    ViewData["Title"] = "Farmer Dashboard";
}

<link rel="stylesheet" href="~/css/farmerdashboard.css" />

<div class="dashboard-wrapper">
    <div class="dashboard-header">
        <h1>Farmer Dashboard</h1>
        <p class="subtitle">Overview of your farm's performance and inventory.</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-icon">📦</span>
            <div class="stat-info">
                <span class="stat-label">Total Products</span>
                <span class="stat-value">@ViewBag.TotalProducts</span>
            </div>
        </div>

        <div class="stat-card warning">
            <span class="stat-icon">⚠️</span>
            <div class="stat-info">
                <span class="stat-label">Low Stock</span>
                <span class="stat-value">@ViewBag.LowStockCount</span>
            </div>
        </div>

        <div class="stat-card success">
            <span class="stat-icon">🚜</span>
            <div class="stat-info">
                <span class="stat-label">Total Stock Units</span>
                <span class="stat-value">@ViewBag.TotalStock</span>
            </div>
        </div>
    </div>

    <div class="dashboard-main-grid">
        <div class="dashboard-section card">
            <div class="section-header">
                <h2>Product Inventory</h2>
                <a asp-controller="Products" asp-action="Index" class="btn-view-all">View All</a>
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">You do not have any products yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Take(5))
                            {
                                <tr>
                                    <td class="font-bold">@item.ProductName</td>
                                    <td>£@item.ProductPrice.ToString("F2")</td>
                                    <td>
                                        <span class="stock-indicator @(item.StockQuantity < 5 ? "low" : "")">
                                            @item.StockQuantity
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="dashboard-section card">
            <div class="section-header">
                <h2>Recent Orders</h2>
                <a asp-controller="Orders" asp-action="Index" class="btn-view-all">View All</a>
            </div>

            @if (ViewBag.RecentOrders == null || ((List<GreenFieldLocalHub.Models.Orders>)ViewBag.RecentOrders).Count == 0)
            {
                <div class="empty-state">No recent orders found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Order</th>
                                <th>Status</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in ((List<GreenFieldLocalHub.Models.Orders>)ViewBag.RecentOrders).Take(5))
                            {
                                <tr>
                                    <td class="email-cell">
                                        @{
                                            var emailDict = (Dictionary<string, string>)ViewBag.UserEmails;
                                            var userEmail = emailDict != null && emailDict.ContainsKey(order.UserId) ? emailDict[order.UserId] : "Unknown";
                                        }
                                        @userEmail
                                    </td>
                                    <td class="items-cell">
                                        @foreach (var op in order.OrderProducts)
                                        {
                                            <span>@op.Products.ProductName (@op.ProductsQuantity)</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-pill @order.OrderTrackingStatus.ToString().ToLower()">
                                            @order.OrderTrackingStatus
                                        </span>
                                    </td>
                                    <td class="font-bold">£@order.TotalAmount.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>